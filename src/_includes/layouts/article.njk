---
layout: layouts/base.njk
---
{% set base = imgBase %}
<article>

  <!-- HEADER ========================================================== -->
  <!-- cabecera: "foto" (default) = photo full bleed with the title over it; "titulo" = title on white, then the
       photo; "texto" = no photo. If the article has a video, a small control plays it in place of the photo. -->
  {% set cab = cabecera or "foto" %}
  {% if not hero %}{% set cab = "texto" %}{% endif %}
  {% macro heroFrame() %}
    <div class="hero-frame" data-hero-frame>
      <img class="hero-img"
           src="{{ base }}{{ hero.file }}-1920.jpg"
           srcset="{{ base }}{{ hero.file }}-1280.jpg 1280w, {{ base }}{{ hero.file }}-1920.jpg 1920w, {{ base }}{{ hero.file }}-2560.jpg 2560w"
           sizes="100vw" width="{{ hero.w }}" height="{{ hero.h }}"
           alt="{{ hero.alt }}" fetchpriority="high" decoding="async">
      {% if youtube %}
      <div class="hero-controls">
        <div class="container d-flex justify-content-end">
          <button type="button" class="btn btn-primary btn-sm font-ui hero-play" data-video="{{ youtube }}" data-video-title="{{ ui.videoTitle }}: {{ title }}" aria-label="{{ ui.playVideoLabel }}" hidden>
            <span class="material-symbols-outlined me-1" aria-hidden="true">play_arrow</span>{{ ui.playVideo }}
          </button>
          <noscript><a class="btn btn-primary btn-sm font-ui" href="https://www.youtube.com/watch?v={{ youtube }}">{{ ui.watchOnYoutube }}</a></noscript>
        </div>
      </div>
      {% endif %}
    </div>
  {% endmacro %}
  {% set sectionName %}{% for s in site.sections %}{% if s.id == section %}{{ s[lang] }}{% endif %}{% endfor %}{% endset %}
  {% if cab == "foto" %}
  <header class="article-hero" data-hero>
    {{ heroFrame() }}
    {% if hero.caption %}<p class="hero-credit figure-caption container mb-0 pt-2">{{ hero.caption | mdi | safe }}</p>{% endif %}
    <div class="hero-text">
      <div class="container d-grid gap-3">
        <span class="tape">{{ sectionName }}</span>
        <h1 class="hero-title mb-0">{{ title }}</h1>
      </div>
    </div>
  </header>
  {% else %}
  <header class="article-head">
    <div class="container d-grid gap-3 pt-5">
      <span class="tape">{{ sectionName }}</span>
      <h1 class="hero-title mb-0">{{ title }}</h1>
    </div>
    {% if cab == "titulo" %}
    <div class="container mt-4 article-hero article-hero-boxed" data-hero>
      {{ heroFrame() }}
      {% if hero.caption %}<p class="hero-credit figure-caption mb-0 pt-2">{{ hero.caption | mdi | safe }}</p>{% endif %}
    </div>
    {% endif %}
  </header>
  {% endif %}

  {% if ai %}
  <!-- Notice band: full bleed background, text on the page margins -->
  <div class="notice-band tone-amarillo mt-4 mt-lg-5" role="note">
    <div class="container py-3"><strong>{{ ui.aiTitle }}.</strong> {{ ui.aiNotice }}</div>
  </div>
  {% endif %}

  <!-- INTRO + FACTS ===================================================== -->
  <div class="container pt-4 pt-lg-5">
    <div class="row">
      <div class="col-xl-10 d-grid gap-4">
        <p class="lead measure mb-0">{{ subtitle | mdi | safe }}</p>
        <ul class="list-inline small-meta mb-0">
          <li class="list-inline-item me-4"><strong class="text-body">{{ ui.by }} {{ author }}</strong></li>
          <li class="list-inline-item me-4"><time datetime="{{ date | dateISO }}">{{ date | dateLong(lang) }}</time></li>
          <li class="list-inline-item">{{ content | readingMinutes }} {{ ui.minRead }}</li>
        </ul>
      </div>
    </div>
    {% if route %}
    <dl class="row row-cols-2 row-cols-md-4 g-4 py-4 mt-4 mb-5 border-top border-bottom border-2 border-strong">
      {% for r in route %}
      <div class="col"><dt class="small-meta fw-semibold font-ui">{{ r.label }}</dt><dd class="h3 mb-0">{{ r.value }}{% if r.unit %} <small class="fs-6 text-body-secondary font-ui fw-semibold">{{ r.unit }}</small>{% endif %}</dd></div>
      {% endfor %}
    </dl>
    {% endif %}
  </div>

  <!-- BODY ============================================================== -->
  <div class="article-body" data-pagefind-body>
    {{ content | safe }}
  </div>

  {% set credits = [hero.credit or credit] %}
  {% for id, ph in photos %}{% set c = ph.credit or credit %}{% if c not in credits %}{% set _ = credits.push(c) %}{% endif %}{% endfor %}
  <div class="pb-5">
    <div class="article-end d-grid gap-2">
      <p class="small-meta mb-0"><strong class="text-body">{{ ui.photos }}:</strong> {{ credits | join(", ") }}</p>
      {% if sources %}<p class="small-meta mb-0"><strong class="text-body">{{ ui.sources }}:</strong> {{ sources | join(" · ") }}</p>{% endif %}
    </div>
  </div>
</article>
