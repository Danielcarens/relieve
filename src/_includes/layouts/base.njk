<!doctype html>
<html lang="{{ ui.htmlLang }}" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · {{ site.name }}</title>
  <meta name="description" content="{{ description or subtitle or ui.tagline }}">
  {% if draft %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or subtitle }}">
  <meta property="og:locale" content="{{ ui.htmlLang | replace('-', '_') }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if hero %}<meta property="og:image" content="{{ site.url }}{{ imgBase }}{{ hero.file }}-1920.jpg">{% endif %}

  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="/assets/fonts/archivo-latin-wdth-wght.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=play_arrow,search,swap_horiz&display=block">

  <!-- Bootstrap 5.3.8, then our theme (order matters) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/assets/css/theme.css">

  <script src="/assets/js/site.js" defer></script>
</head>
<body>
  {% include "partials/logo-defs.njk" %}
  <a class="visually-hidden-focusable" href="#main">{{ ui.skip }}</a>
  {% if draft %}<div class="bg-dark text-light font-ui small py-2 text-center" role="note">{{ ui.draftBanner }}</div>{% endif %}

  {% include "partials/navbar.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <!-- Bootstrap JS bundle (includes Popper): needed for the navbar menu -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
